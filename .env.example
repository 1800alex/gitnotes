# Copy to .env and adjust. docker-compose reads this automatically.

# --- Required ---
# Long random string used to sign login tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Run as your host user (so commits + SSH + file ownership line up) ---
# Find yours with:  id -u   and   id -g
PUID=1000
PGID=1000

# --- Optional ---
# Host port to expose the app on.
PORT=8080

# How long a login stays valid, in hours (default 720 = 30 days).
TOKEN_TTL_HOURS=720

# Accounts file (usernames + bcrypt hashes). See users.example.json.
USERS_FILE=./users.json

# SSH keys + gitconfig to mount for git auth/identity.
SSH_DIR=/home/user/.ssh
GITCONFIG=/home/user/.gitconfig

# Override the commit identity (otherwise taken from the mounted .gitconfig).
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Push after every change / pull on startup.
AUTO_PUSH=true
AUTO_PULL=true
